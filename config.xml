<?xml version='1.0' encoding='utf-8'?>
<widget id="io.github.hangueth.cantemus" version="1.19.3" xmlns="http://www.w3.org/ns/widgets" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>Cantemus</name>
    <description>
        GABC Chant Tools available at http://bbloomf.github.io/jgabc/
    </description>
    <author email="bhb123+jgabc@gmail.com" href="http://github.com/bbloomf">
        Benjamin Bloomfield
    </author>
    <hook type="before_prepare" src="hooks/sync-config-version.js" />
    <content src="propers.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-intent href="tel:*" />
    <allow-intent href="sms:*" />
    <allow-intent href="mailto:*" />
    <allow-intent href="geo:*" />
    <platform name="android">
        <allow-intent href="market:*" />
        <icon density="ldpi" src="res/mipmap-ldpi/icon.png" background="res/mipmap-ldpi/icon-background.png" foreground="res/mipmap-ldpi/icon-foreground.png" />
        <icon density="mdpi" src="res/mipmap-mdpi/icon.png" background="res/mipmap-mdpi/icon-background.png" foreground="res/mipmap-mdpi/icon-foreground.png" />
        <icon density="hdpi" src="res/mipmap-hdpi/icon.png" background="res/mipmap-hdpi/icon-background.png" foreground="res/mipmap-hdpi/icon-foreground.png" />
        <icon density="xhdpi" src="res/mipmap-xhdpi/icon.png" background="res/mipmap-xhdpi/icon-background.png" foreground="res/mipmap-xhdpi/icon-foreground.png" />
        <icon density="xxhdpi" src="res/mipmap-xxhdpi/icon.png" background="res/mipmap-xxhdpi/icon-background.png" foreground="res/mipmap-xxhdpi/icon-foreground.png" />
        <icon density="xxxhdpi" src="res/mipmap-xxxhdpi/icon.png" background="res/mipmap-xxxhdpi/icon-background.png" foreground="res/mipmap-xxxhdpi/icon-foreground.png" />
        <preference name="AndroidLaunchMode" value="singleTask" />
        <preference name="android-targetSdkVersion" value="36" />
        <preference name="AndroidWindowSplashScreenAnimatedIcon" value="res/screen/android/splash-icon.png" />
        <preference name="AndroidWindowSplashScreenAnimationDuration" value="0" />
        <!-- Dark mode: pure-black night colors, matching www/theme.css (the splash icon is the same in both modes) -->
        <resource-file src="res/android/values-night/cdv_colors.xml" target="app/src/main/res/values-night/cdv_colors.xml" />
        <resource-file src="res/android/values-night-v34/cdv_colors.xml" target="app/src/main/res/values-night-v34/cdv_colors.xml" />
        <!-- Let's Encrypt's root certificates for Android 7.0 (see res/android/xml/network_security_config.xml) -->
        <resource-file src="res/android/xml/network_security_config.xml" target="app/src/main/res/xml/network_security_config.xml" />
        <resource-file src="res/android/raw/isrg_root_x1.pem" target="app/src/main/res/raw/isrg_root_x1.pem" />
        <resource-file src="res/android/raw/isrg_root_x2.pem" target="app/src/main/res/raw/isrg_root_x2.pem" />
        <edit-config file="app/src/main/AndroidManifest.xml" mode="merge" target="/manifest/application">
            <application android:networkSecurityConfig="@xml/network_security_config" />
        </edit-config>
        <config-file parent="/*/application/activity" target="AndroidManifest.xml">
            <!-- My chants files (.mychants, exported by the app) opened from WhatsApp, Drive, e-mail or the files app.
                 Apps that receive the file rarely keep its extension or a specific type, so the app offers to open
                 JSON and generic files; www/js/index.js shows the chants, or says the file isn't a My chants file. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/x-mychants" />
            </intent-filter>
            <!-- file managers that give the file's name: any type, but only .mychants -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.mychants" />
                <data android:pathPattern=".*\\..*\\.mychants" />
                <data android:pathPattern=".*\\..*\\..*\\.mychants" />
            </intent-filter>
            <!-- Cantemus's own links, verified by https://hangueth.github.io/.well-known/assetlinks.json -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:host="hangueth.github.io" android:pathPrefix="/jgabc" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
            <!-- Chant Tools links, which open in Chant Tools when it's installed; Cantemus can open them if chosen in the app's settings -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:host="bbloomf.github.io" android:pathPrefix="/jgabc" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
        </config-file>
        <!-- <edit-config file="app/src/main/AndroidManifest.xml" mode="merge" target="/manifest/application/activity">
            <activity android:exported="true"/>
        </edit-config> -->
        <!-- <edit-config file="app/src/main/AndroidManifest.xml" mode="merge" target="/manifest/application/receiver[@android:name='nl.xservices.plugins.ShareChooserPendingIntent']">
            <activity android:exported="true"/>
        </edit-config> -->
    </platform>
    <platform name="ios">
        <preference name="deployment-target" value="15.0" />
        <preference name="scheme" value="app" />
        <preference name="hostname" value="localhost" />
        <splash src="res/screen/ios/Default@2x~universal~anyany.png" />
        <allow-intent href="itms:*" />
        <allow-intent href="itms-apps:*" />
        <icon height="20" src="res/ios/Icon-App-20x20@1x.png" width="20" />
        <icon height="40" src="res/ios/Icon-App-20x20@2x.png" width="40" />
        <icon height="60" src="res/ios/Icon-App-20x20@3x.png" width="60" />
        <icon height="29" src="res/ios/Icon-App-29x29@1x.png" width="29" />
        <icon height="58" src="res/ios/Icon-App-29x29@2x.png" width="58" />
        <icon height="87" src="res/ios/Icon-App-29x29@3x.png" width="87" />
        <icon height="40" src="res/ios/Icon-App-40x40@1x.png" width="40" />
        <icon height="80" src="res/ios/Icon-App-40x40@2x.png" width="80" />
        <icon height="120" src="res/ios/Icon-App-40x40@3x.png" width="120" />
        <icon height="57" src="res/ios/Icon-App-57x57@1x.png" width="57" />
        <icon height="114" src="res/ios/Icon-App-57x57@2x.png" width="114" />
        <icon height="60" src="res/ios/Icon-App-60x60@1x.png" width="60" />
        <icon height="120" src="res/ios/Icon-App-60x60@2x.png" width="120" />
        <icon height="180" src="res/ios/Icon-App-60x60@3x.png" width="180" />
        <icon height="72" src="res/ios/Icon-App-72x72@1x.png" width="72" />
        <icon height="144" src="res/ios/Icon-App-72x72@2x.png" width="144" />
        <icon height="76" src="res/ios/Icon-App-76x76@1x.png" width="76" />
        <icon height="152" src="res/ios/Icon-App-76x76@2x.png" width="152" />
        <icon height="228" src="res/ios/Icon-App-76x76@3x.png" width="228" />
        <icon height="167" src="res/ios/Icon-App-83.5x83.5@2x.png" width="167" />
        <icon height="50" src="res/ios/Icon-Small-50x50@1x.png" width="50" />
        <icon height="100" src="res/ios/Icon-Small-50x50@2x.png" width="100" />
        <icon height="1024" src="res/ios/Icon-1024.png" width="1024" />
    </platform>
</widget>
